<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F7F8FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ActiveHabit"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#5E4BA5"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добро пожаловать!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Следи за тренировками и формируй полезные привычки"
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnWorkouts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Тренировки"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnHabits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Привычки"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStatistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статистика"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Мой профиль" />

</LinearLayout>