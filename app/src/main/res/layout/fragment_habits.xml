<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F7F8FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Мои привычки"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#25233A"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAddHabit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Добавить привычку"
        android:layout_marginBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/habitsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHabitsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузка привычек..."
                android:textSize="16sp"
                android:textColor="#555555" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>